if (WIN32 AND MINGW)
    if (DEFINED ENV{ORATYPE_WIN_VULKAN_SDK} AND NOT "$ENV{ORATYPE_WIN_VULKAN_SDK}" STREQUAL "")
        set(_oratype_vk_sdk "$ENV{ORATYPE_WIN_VULKAN_SDK}")
    else()
        set(_oratype_vk_sdk "/tmp/oratype-vulkan-sdk")
    endif()

    if (EXISTS "${_oratype_vk_sdk}/include/vulkan/vulkan_core.h" AND EXISTS "${_oratype_vk_sdk}/lib/libvulkan.dll.a")
        set(Vulkan_INCLUDE_DIR "${_oratype_vk_sdk}/include" CACHE PATH "" FORCE)
        set(Vulkan_LIBRARY "${_oratype_vk_sdk}/lib/libvulkan.dll.a" CACHE FILEPATH "" FORCE)
        if (EXISTS "/usr/sbin/glslc")
            set(Vulkan_GLSLC_EXECUTABLE "/usr/sbin/glslc" CACHE FILEPATH "" FORCE)
        endif()
    endif()

    function(_oratype_fix_mingw_ggml_prefixes)
        foreach(_tgt IN ITEMS ggml ggml-base ggml-cpu ggml-vulkan)
            if (TARGET ${_tgt})
                set_target_properties(${_tgt} PROPERTIES PREFIX "lib")
            endif()
        endforeach()
    endfunction()
    cmake_language(DEFER CALL _oratype_fix_mingw_ggml_prefixes)
endif()
